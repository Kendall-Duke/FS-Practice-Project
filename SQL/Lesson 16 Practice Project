select st.sale_id,
       pt.product_name,
       st.sale_date, 
       st.quantity_sold,
       sum(st.quantity_sold) over (partition by st.product_id) as Total_Product_Sales
from sales_table st
left join product_table pt on pt.product_id = st.product_id
order by pt.product_name, st.sale_date;

With cte as (
SELECT STRFTIME('%Y-%m', st.sale_date) as Sale_Month, 
       sum(st.quantity_sold) as Monthly_Total_Sales
FROM sales_table st
LEFT JOIN product_table pt on pt.product_id = st.product_id
GROUP BY Sale_Month 
)
Select Sale_Month,
       Monthly_Total_Sales,
       sum(Monthly_Total_Sales ) over (partition by substr(Sale_Month, 1, 4) order by Sale_Month) as Yearly_Running_Total
From cte;

with product_totals as (
     select pt.product_name, 
            sum(st.quantity_sold) as total_product_sales
     from sales_table st
     left join product_table pt on pt.product_id = st.product_id
     group by pt.product_id, pt.product_name 
),
ranked as (
    select *,
           rank() over (order by total_product_sales desc) as sales_rank
    from product_totals
)
select *
from ranked
where sales_rank <= 3;
