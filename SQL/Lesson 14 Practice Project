Select *
From patients_table;

Select count(distinct pid)
From patients_table;

Select pid, p_name, DATE('now') 
From patients_table;

Select p_name as old_patient_name,
Upper(p_name) as new_patient_name
From patients_table;

Select p_name, LENGTH(p_name) as character_count
From patients_table;

Select CONCAT(p_name,', ',doctor_name) as patient_doctor_names
From patients_table; 

SELECT date, substr(date,7,4) AS extracted_year
FROM patients_table;

SELECT doctor_name, COUNT(*) AS count
FROM patients_table
GROUP BY doctor_name
HAVING COUNT(*) > 1;




