CREATE TABLE IF NOT EXISTS patients_table(
 pid VARCHAR primary key, 
 date Date, 
 p_name VARCHAR(255) NULL,
 age INTEGER,
 weight Integer,
 gender VARCHAR (100),
 location VARCHAR(255) NULL,
 phone_no Integer,
 disease VARCHAR(255) NULL,
 doctor_name VARCHAR(255) NULL, 
 doctor_id Integer);

