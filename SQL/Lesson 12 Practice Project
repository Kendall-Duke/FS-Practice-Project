CREATE TABLE IF NOT EXISTS product_table(
 p_code INTEGER Primary Key Autoincrement, 
 p_name VARCHAR(250),
 price INTEGER,
 stock Integer,
 category VARCHAR (250));

Select *
From product_table;

CREATE TABLE IF NOT EXISTS sales_table(
 p_code INTEGER Primary Key Autoincrement, 
 p_name VARCHAR(250),
 order_date DATE,
 order_no INTEGER,
 c_id INTEGER,
 c_name VARCHAR(250),
 s_code INTEGER,
 qty INTEGER,
 price INTEGER);

