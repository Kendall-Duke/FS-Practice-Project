CREATE TABLE IF NOT EXISTS xyz_employee(
 emp_id INTEGER Primary Key Autoincrement, 
 f_name VARCHAR(100),
 l_name VARCHAR(100),
 job_id VARCHAR(100),
 salary Integer,
 manager_id Integer,
 dept_id Integer
);

