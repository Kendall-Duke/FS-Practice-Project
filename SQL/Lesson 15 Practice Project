SELECT xe.f_name, xe.l_name
FROM xyz_employee xe 
JOIN xyz_employee xe2 
  ON xe.salary > xe2.salary
WHERE xe2.f_name = 'Calvin';

Select emp_id, l_name
from xyz_employee xe 
where xe.salary > (select avg(salary) from xyz_employee);

SELECT emp_id, f_name
FROM (
    SELECT emp_id, f_name, salary
    FROM xyz_employee xe
    EXCEPT
    SELECT xe1.emp_id, xe1.f_name, xe1.salary
    FROM xyz_employee xe1
    JOIN xyz_employee xe2 ON xe2.job_id = 'MW789'
    WHERE xe1.salary <= xe2.salary
)
ORDER BY salary;

Select xe.f_name, xe.emp_id, xe.salary 
From (
	Select DISTINCT salary 
	From xyz_employee xe 
	Order by salary DESC
	Limit 3
) as Top_Earners 
Join xyz_employee xe on xe.salary = top_earners.salary;
