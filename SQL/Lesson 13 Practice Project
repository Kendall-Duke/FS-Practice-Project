/* Write a query to display the student ID and first name of every 
 * student in the students table whose age is greater than or 
 * equal to 16 and whose last name is Kumar*/

Select s_id, s_fname
From student_datasets_xlsx 
Where student_datasets_xlsx.age >= 16 
AND student_datasets_xlsx.s_lname = 'kumar';

Select *
From marksheet_datasets_xlsx mdx 
Where score BETWEEN 800 AND 1000;

Select *, score + 5 as new_score
From marksheet_datasets_xlsx mdx;

Select *, score DESC
From marksheet_datasets_xlsx mdx;

