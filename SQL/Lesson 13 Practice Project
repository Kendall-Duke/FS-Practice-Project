CREATE TABLE IF NOT EXISTS students_table(
 s_id INTEGER Primary Key Autoincrement, 
 s_fname VARCHAR(100),
 s_lname VARCHAR(100),
 class VARCHAR(100),
 age Integer);

CREATE TABLE IF NOT EXISTS marketsheet_table(
 score INTEGER Primary Key Autoincrement, 
 year VARCHAR(100),
 ranking VARCHAR(100),
 class VARCHAR(100),
 s_id Integer);

